{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"rootDirs": ["../..", "../../.."],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"types": ["node"],
		"typeRoots": ["./node_modules/@types", "../../.agents/node_modules/@types"]
	},
	"include": ["extensions/**/*.ts", "extensions/*.ts"],
	"exclude": ["extensions/pi-subagents-4-turnlock/**"]
}
